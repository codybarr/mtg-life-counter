    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "latest",
    "alchemy": "2.0.0-beta.87",
    "tailwindcss": "^4.3.5",
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.15.0",
